# Copy this file to .env and fill in real values (if any). .env is gitignored.
#
# No API key needed — matching, extraction, and email triage all run on a
# local Ollama model (default: qwen2.5:1.5b). Install Ollama (https://ollama.com)
# and run `ollama pull qwen2.5:1.5b` before using jobhunter.

# Optional overrides — leave unset to use config.yaml defaults.
OLLAMA_HOST=
JOBHUNTER_CONFIG=config.yaml

# Optional: send the notification digest via plain SMTP with a Gmail app
# password instead of the Gmail OAuth flow. Set both to skip the OAuth
# browser consent step entirely for notifications (inbox triage still uses
# Gmail OAuth). Generate an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
